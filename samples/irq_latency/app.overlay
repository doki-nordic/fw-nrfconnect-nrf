/ {
	zephyr,user {
		pwms = <&pwm130 0 PWM_MSEC(5) PWM_POLARITY_NORMAL>;
	};

	gpiosout {
		compatible = "gpio-leds";
		trigger_pin: trigger-pin {
			gpios = <&gpio0 0 0>;
			label = "IRQ Latency trigger pin";
		};
		response0_pin: response0-pin {
			gpios = <&gpio0 4 0>;
			label = "IRQ Latency response0 pin";
		};
		response1_pin: response1-pin {
			gpios = <&gpio0 5 0>;
			label = "IRQ Latency response1 pin";
		};
		response2_pin: response2-pin {
			gpios = <&gpio0 6 0>;
			label = "IRQ Latency response2 pin";
		};
		response3_pin: response3-pin {
			gpios = <&gpio0 7 0>;
			label = "IRQ Latency response3 pin";
		};
	};

	gpiosin {
		compatible = "gpio-keys";
		input_pin: input-pin {
			gpios = <&gpio0 1 0>;
			label = "IRQ Latency input pin";
		};
	};
};

&pinctrl {
        pwm130_default_alt: pwm130_default_alt {
                group1 {
                        psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
                };
        };

        pwm130_sleep_alt: pwm130_sleep_alt {
                group1 {
                        psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
                        low-power-enable;
                };
        };
};

&pwm130 {
	status = "okay";
	pinctrl-0 = <&pwm130_default_alt>;
	pinctrl-1 = <&pwm130_sleep_alt>;
	pinctrl-names = "default", "sleep";
};
